# Copy to moonshot.env (gitignored) and set the token. compose.yaml reads it.
#
# The API token protects the dashboard and the API. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MOONSHOT_API_TOKEN=

# Testnet mode (mode = "testnet" in the run config): the Binance spot testnet keys, created at
# https://testnet.binance.vision/ . compose.yaml passes this file to the container as environment
# variables, so no .env file is needed inside it. Mainnet hosts are refused by the daemon.
# MOONSHOT_BINANCE_TESTNET_API_KEY=
# MOONSHOT_BINANCE_TESTNET_API_SECRET=
